  "cards": [
    {
      "dot": "cyan",
      "title": "半双工规则",
      "items": [
        "DE=1 发送、DE=0 接收，同一时刻只能单向",
        "发送前后由 rs485_send 自动切换方向",
        "总线上同一时刻只允许一个发送者"
      ]
    },
    {
      "dot": "emerald",
      "title": "判帧与校验",
      "items": [
        "IDLE 中断判定帧结束，避免固定字节数拆帧",
        "最短合法帧 8 字节，不足视为线路噪声",
        "CRC16 查表校验 + 从机地址过滤，失败静默"
      ]
    },
    {
      "dot": "rose",
      "title": "无条件切回",
      "items": [
        "发送完成后立即恢复接收方向",
        "发送超时也同样切回，避免总线卡死",
        "静默丢弃后直接回到监听态"
      ]
    }
  ]
}