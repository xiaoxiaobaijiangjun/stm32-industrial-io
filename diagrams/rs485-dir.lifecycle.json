    }
  ],
  "states": [
    {
      "id": "rx_listen",
      "type": "start",
      "label": "RX 监听",
      "sublabel": "DE=0 · RXNE 入环形缓冲",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "常态"
    },
    {
      "id": "frame_ready",
      "type": "active",
      "label": "帧就绪",
      "sublabel": "IDLE 中断 · frame_ready=1",
      "lane": "main",
      "col": 1,
      "step": "02"
    },
    {
      "id": "need_reply",
